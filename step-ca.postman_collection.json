            "body": {
              "mode": "raw",
              "raw": "{\n  \"csr\": \"{{csr}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/rekey",
